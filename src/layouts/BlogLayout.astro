---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: Date;
  tags?: string[];
  description?: string;
}

const { title, date, tags = [], description } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — Yuanyi Yan`} description={description}>
  <article>
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-slate-900">{title}</h1>
      <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-slate-500">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {tags.length > 0 && (
          <ul class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="text-xs bg-indigo-50 text-indigo-700 rounded-full px-2.5 py-0.5">{tag}</li>
            ))}
          </ul>
        )}
      </div>
    </header>
    <div class="prose-content">
      <slot />
    </div>
    <div class="mt-12">
      <a href="/blog" class="text-sm text-indigo-600 hover:underline">&larr; Back to all posts</a>
    </div>
  </article>
</BaseLayout>
