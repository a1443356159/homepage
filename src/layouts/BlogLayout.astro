---
import BaseLayout from './BaseLayout.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  date: Date;
  tags?: string[];
  description?: string;
  category: string;
  updated?: Date;
  headings: MarkdownHeading[];
}

const { title, date, tags = [], description, category, updated, headings } = Astro.props;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={`${title} — Yuanyi Yan`} description={description}>
  <article class="min-w-0">
    <a href="/blog" class="text-sm text-indigo-600 hover:underline">&larr; Knowledge base</a>
    <header class="mt-6 mb-8 border-b border-slate-200 pb-6">
      <a href={`/blog?category=${encodeURIComponent(category)}`} class="mb-3 inline-block text-xs font-semibold uppercase tracking-wider text-indigo-600 hover:underline">{category}</a>
      <h1 class="text-3xl font-bold text-slate-900">{title}</h1>
      <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-slate-500">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {updated && <span>Updated <time datetime={updated.toISOString()}>{updated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time></span>}
        {tags.length > 0 && (
          <ul class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li><a href={`/blog?tag=${encodeURIComponent(tag)}`} class="text-xs bg-indigo-50 text-indigo-700 rounded-full px-2.5 py-0.5 hover:underline">{tag}</a></li>
            ))}
          </ul>
        )}
      </div>
    </header>
    <div class:list={['grid gap-8', { 'md:grid-cols-[minmax(0,1fr)_11rem]': toc.length > 0 }]}>
      {toc.length > 0 && <aside class="md:order-2">
        <nav aria-label="On this page" class="rounded-lg border border-slate-200 bg-slate-50 p-4 md:sticky md:top-8">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500">On this page</h2>
          <ul class="mt-3 space-y-3 text-sm leading-snug">
            {toc.map((heading) => <li class:list={{ 'pl-3': heading.depth === 3 }}><a href={`#${heading.slug}`} class="text-slate-600 hover:text-indigo-600">{heading.text}</a></li>)}
          </ul>
        </nav>
      </aside>}
      <div class="prose-content min-w-0">
        <slot />
      </div>
    </div>
    <div class="mt-12">
      <a href="/blog" class="text-sm text-indigo-600 hover:underline">&larr; Back to all notes</a>
    </div>
  </article>
</BaseLayout>
