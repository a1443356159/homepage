---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => (b.data.updated ?? b.data.date).valueOf() - (a.data.updated ?? a.data.date).valueOf());
const categories = [...new Set(posts.map((post) => post.data.category))].sort();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
const formatDate = (date: Date) => date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC',
});
---

<BaseLayout title="Knowledge Base — Yuanyi Yan" description="A growing collection of technical notes on generative models, embodied AI, and systems. Browse by topic or search across the notes.">
  <header class="border-b border-slate-200 pb-8">
    <p class="text-xs font-semibold uppercase tracking-widest text-indigo-600">Blog / Notes &amp; references</p>
    <h1 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-slate-900">Knowledge base</h1>
    <p class="mt-4 max-w-xl text-slate-600 leading-relaxed">A growing collection of things I’m learning, building, and revisiting. Working notes on generative models, embodied AI, and systems.</p>
  </header>

  <div class="mt-8 grid gap-8 md:grid-cols-[11rem_minmax(0,1fr)]" data-knowledge-base>
    <aside>
      <nav aria-label="Note categories" class="md:sticky md:top-8">
        <h2 class="mb-3 text-xs font-semibold uppercase tracking-widest text-slate-500">Browse topics</h2>
        <div class="flex flex-wrap gap-1 md:flex-col">
          <a href="/blog" data-category="" aria-current="true" class="category-link">
            <span>All notes</span><span class="text-xs text-slate-500">{posts.length}</span>
          </a>
          {categories.map((category) => (
            <a href={`/blog?category=${encodeURIComponent(category)}`} data-category={category} class="category-link">
              <span>{category}</span><span class="text-xs text-slate-500">{posts.filter((post) => post.data.category === category).length}</span>
            </a>
          ))}
        </div>
        <p class="mt-6 hidden text-xs leading-relaxed text-slate-500 md:block">These notes evolve as my understanding changes.</p>
      </nav>
    </aside>

    <section aria-label="Notes" class="min-w-0">
      <form role="search" action="/blog" class="space-y-3" id="note-filters">
        <label for="note-search" class="sr-only">Search notes</label>
        <div class="relative">
          <svg class="absolute left-3.5 top-3.5 text-slate-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
          <input id="note-search" name="q" type="search" placeholder="Search titles, topics, and full notes…" autocomplete="off" class="w-full rounded-lg border border-slate-300 bg-slate-50 py-3 pl-11 pr-4 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" />
        </div>
        <div class="flex flex-wrap items-center gap-3 text-sm">
          <label for="note-tag" class="text-slate-500">Tag</label>
          <select id="note-tag" name="tag" class="min-w-0 max-w-full rounded-md border border-slate-300 bg-white px-2 py-1.5">
            <option value="">All tags</option>
            {tags.map((tag) => <option value={tag}>{tag}</option>)}
          </select>
          <button id="reset-filters" type="button" hidden class="text-indigo-600 hover:underline">Clear filters</button>
        </div>
      </form>
      <noscript><p class="mt-4 text-sm text-slate-500">Enable JavaScript to search and filter. All published notes are listed below.</p></noscript>

      <div class="mt-7 flex items-center justify-between border-b border-slate-200 pb-3 text-xs text-slate-500">
        <p id="note-count" role="status" aria-live="polite" aria-atomic="true">{posts.length} {posts.length === 1 ? 'note' : 'notes'}</p>
        <span>Recently updated first</span>
      </div>
      <ul id="note-list" class="divide-y divide-slate-200">
        {posts.map((post) => (
          <li data-note data-note-category={post.data.category} data-tags={JSON.stringify(post.data.tags)} data-search={[post.data.title, post.data.description, post.data.category, ...post.data.tags, post.body ?? ''].join(' ').toLocaleLowerCase()} class="py-6">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
              <span class="font-medium text-indigo-600">{post.data.category}</span>
              <time class="text-slate-500" datetime={(post.data.updated ?? post.data.date).toISOString()}>{post.data.updated ? 'Updated ' : ''}{formatDate(post.data.updated ?? post.data.date)}</time>
            </div>
            <h2 class="mt-2 text-xl font-semibold tracking-tight text-slate-900"><a href={`/blog/${post.id}`} class="hover:text-indigo-600">{post.data.title}<span aria-hidden="true" class="ml-2 text-base text-slate-400">↗</span></a></h2>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{post.data.description}</p>
            {post.data.tags.length > 0 && <ul class="mt-3 flex flex-wrap gap-2" aria-label="Tags">{post.data.tags.map((tag) => <li><a href={`/blog?tag=${encodeURIComponent(tag)}`} data-tag-link={tag} class="rounded bg-slate-100 px-2 py-1 text-xs text-slate-600 hover:bg-indigo-50 hover:text-indigo-700">{tag}</a></li>)}</ul>}
          </li>
        ))}
      </ul>
      <div id="no-results" hidden class="rounded-lg border border-dashed border-slate-300 px-6 py-12 text-center">
        <h2 class="font-semibold text-slate-900">No matching notes</h2>
        <p class="mt-2 text-sm text-slate-500">Try another search term or clear the filters.</p>
        <button type="button" data-reset class="mt-4 text-sm text-indigo-600 hover:underline">Show all notes</button>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  @reference "../../styles/global.css";
  .category-link { @apply flex items-center justify-between gap-3 rounded-md px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 hover:text-indigo-600; }
  .category-link[aria-current="true"] { @apply bg-indigo-50 font-medium text-indigo-700; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-knowledge-base]');
  if (root) {
    const search = root.querySelector<HTMLInputElement>('#note-search')!;
    const tagSelect = root.querySelector<HTMLSelectElement>('#note-tag')!;
    const notes = [...root.querySelectorAll<HTMLElement>('[data-note]')].map((element) => ({
      element, tags: JSON.parse(element.dataset.tags ?? '[]') as string[],
    }));
    const categories = [...root.querySelectorAll<HTMLAnchorElement>('[data-category]')];
    const reset = root.querySelector<HTMLButtonElement>('#reset-filters')!;
    let category = '';

    function filter(updateUrl = true) {
      const terms = search.value.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);
      let count = 0;
      for (const { element, tags } of notes) {
        const matches = (!category || element.dataset.noteCategory === category)
          && (!tagSelect.value || tags.includes(tagSelect.value))
          && terms.every((term) => (element.dataset.search ?? '').includes(term));
        element.hidden = !matches;
        if (matches) count++;
      }
      categories.forEach((link) => {
        if (link.dataset.category === category) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
      root!.querySelector('#note-count')!.textContent = `${count} ${count === 1 ? 'note' : 'notes'}`;
      root!.querySelector<HTMLElement>('#no-results')!.hidden = count > 0;
      reset.hidden = !search.value && !category && !tagSelect.value;
      if (updateUrl) {
        const url = new URL(location.href);
        for (const [key, value] of [['q', search.value], ['category', category], ['tag', tagSelect.value]]) {
          if (value) url.searchParams.set(key, value);
          else url.searchParams.delete(key);
        }
        history.replaceState(null, '', url);
      }
    }
    function readUrl() {
      const params = new URLSearchParams(location.search);
      search.value = params.get('q') ?? '';
      category = categories.some((link) => link.dataset.category === params.get('category')) ? params.get('category')! : '';
      const tag = params.get('tag') ?? '';
      tagSelect.value = [...tagSelect.options].some((option) => option.value === tag) ? tag : '';
      filter(false);
    }
    function clear() { search.value = ''; tagSelect.value = ''; category = ''; filter(); }
    search.addEventListener('input', () => filter());
    tagSelect.addEventListener('change', () => filter());
    root.querySelector('form')!.addEventListener('submit', (event) => { event.preventDefault(); filter(); });
    categories.forEach((link) => link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault(); category = link.dataset.category ?? ''; filter();
    }));
    root.querySelectorAll<HTMLAnchorElement>('[data-tag-link]').forEach((link) => link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault(); tagSelect.value = link.dataset.tagLink ?? ''; filter();
    }));
    reset.addEventListener('click', clear);
    root.querySelector('[data-reset]')!.addEventListener('click', clear);
    window.addEventListener('popstate', readUrl);
    readUrl();
  }
</script>
