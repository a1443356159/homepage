---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const bySlug = (id: string) => projects.find((p) => p.id === id);

const generativeModelProjects = ['looped-flow-matching']
  .map(bySlug)
  .filter((p) => p !== undefined);

const embodiedProjects = ['toolmind-agent']
  .map(bySlug)
  .filter((p) => p !== undefined);
---

<BaseLayout
  title="Research — Yuanyi Yan"
  description="Research directions of Yuanyi Yan: generative models (flow matching, training-free refinement) and embodied AI & agent systems."
>
  <h1 class="text-3xl font-bold text-slate-900">Research</h1>
  <p class="mt-3 text-slate-700 leading-relaxed">
    My work follows two connected threads: making generative models better at inference
    time, and grounding learned models in embodied agent systems that perceive and act
    in the physical world.
  </p>

  <section class="mt-12">
    <h2 class="text-xl font-semibold text-slate-900 border-b border-slate-200 pb-2">Generative Models</h2>
    <p class="mt-4 text-slate-700 leading-relaxed">
      Flow-matching generators such as Diffusion Transformers are typically used with a
      fixed sampling budget. I study how to spend test-time compute more cleverly —
      entirely training-free. Directions include <strong>hidden-state refinement</strong>
      (re-injecting intermediate representations through a frozen backbone to correct the
      sampling trajectory), <strong>looped flow matching</strong> (iterative re-passes
      that trade compute for fidelity), <strong>token-selective looping</strong>
      (spending extra loops only on spatial tokens that are still undecided), and
      <strong>Scale-RAE</strong> (scaling rectification-enhanced autoencoders as
      higher-fidelity latent spaces for downstream flow models).
    </p>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {generativeModelProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          tags={project.data.tags}
          image={project.data.image}
          links={{ paper: project.data.paper, code: project.data.code, demo: project.data.demo }}
        />
      ))}
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-semibold text-slate-900 border-b border-slate-200 pb-2">Embodied AI &amp; Agent Systems</h2>
    <p class="mt-4 text-slate-700 leading-relaxed">
      I build agent pipelines that let robots act on natural-language instructions. The
      <strong>ToolMind agent pipeline</strong> decomposes instructions into executable
      motion primitives for a tabletop robotic arm; <strong>RGB-D perception</strong>
      provides calibrated, object-centric scene representations; the
      <strong>robot workstation</strong> integrates cameras, the arm, and safety
      constraints into a reproducible testbed; and <strong>VLA-style planning</strong>
      couples vision-language models with low-level controllers for closed-loop
      execution.
    </p>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {embodiedProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          tags={project.data.tags}
          image={project.data.image}
          links={{ paper: project.data.paper, code: project.data.code, demo: project.data.demo }}
        />
      ))}
    </div>
  </section>
</BaseLayout>
