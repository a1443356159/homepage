---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';

const publications = (await getCollection('publications'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const inPreparation = publications.filter((p) => p.data.status === 'in-preparation');
const preprints = publications.filter((p) => p.data.status === 'preprint');
const published = publications.filter((p) => p.data.status === 'published');

const statusLabel: Record<string, string> = {
  'in-preparation': 'In preparation',
  preprint: 'Preprint',
  published: 'Published',
};
---

<BaseLayout
  title="Publications — Yuanyi Yan"
  description="Publications and manuscripts by Yuanyi Yan."
>
  <h1 class="text-3xl font-bold text-slate-900">Publications</h1>
  <p class="mt-3 text-slate-700">
    This page currently contains placeholder entries. It will be updated with full
    citations, links, and BibTeX records once formal publications are available.
  </p>

  {published.length > 0 && (
    <section class="mt-10">
      <h2 class="text-xl font-semibold text-slate-900 border-b border-slate-200 pb-2">Publications</h2>
      <ul class="mt-6 space-y-6">
        {published.map((pub) => (
          <PublicationItem
            title={pub.data.title}
            authors={pub.data.authors}
            venue={pub.data.venue}
            links={{ paper: pub.data.paper, arxiv: pub.data.arxiv, code: pub.data.code }}
            bibtex={pub.data.bibtex}
          />
        ))}
      </ul>
    </section>
  )}

  <section class="mt-10">
    <h2 class="text-xl font-semibold text-slate-900 border-b border-slate-200 pb-2">Preprints and Manuscripts</h2>
    {[...preprints, ...inPreparation].length > 0 ? (
      <ul class="mt-6 space-y-6">
        {[...preprints, ...inPreparation].map((pub) => (
          <PublicationItem
            title={`${pub.data.title} (${statusLabel[pub.data.status]})`}
            authors={pub.data.authors}
            venue={pub.data.venue}
            links={{ paper: pub.data.paper, arxiv: pub.data.arxiv, code: pub.data.code }}
            bibtex={pub.data.bibtex}
          />
        ))}
      </ul>
    ) : (
      <p class="mt-4 text-sm text-slate-500">Nothing here yet — work in progress.</p>
    )}
  </section>
</BaseLayout>
